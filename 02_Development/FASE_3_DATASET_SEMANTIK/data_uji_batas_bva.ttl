pdp:BVA_Pengendali a pdp:ChildDataController,
        pdp:ConsentBasedController,
        pdp:DataController,
        pdp:DisabilityDataController,
        pdp:HighRiskProcessingController,
        pdp:JointController,
        pdp:LargeScaleSpecificDataActor,
        pdp:PSE ;
    rdfs:label "Pengendali uji batas (salinan PSE FIN, patuh penuh)"@id ;
    pdp:hasAccessControl true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasConsentEvidence true ;
    pdp:hasDPIA true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataProtectionOfficer true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasEncryption true ;
    pdp:hasJointControllerAgreement true ;
    pdp:hasLegalBasis "consent" ;
    pdp:hasParentalConsentForChild true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasProcessingNotice true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasSecurityMeasures true ;
    pdp:hasSpecialConsentForDisability true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasUnauthorizedProcessing false .

