@prefix pdp:   <http://example.org/pdp#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  DATA GRAF SINTETIS: PARTISI ECP-02 SAMPAI ECP-26
#  Metode: Equivalence Class Partitioning (ECP). ECP-01 ada di data_pse_compliant.ttl.
#  Kunci jawaban: FASE_4_VALIDASI/kunci_jawaban_ecp.csv
#
#  N_partisi = N_valid + N_constraint = 2 + 24 = 26
#   - Partisi valid: ECP-01 (patuh penuh) dan ECP-02 (peringatan dini 48 < x <= 72 jam).
#   - Partisi pelanggaran: ECP-03 sampai ECP-26 = kelas batasan K01 sampai K24
#     (dihitung oleh FASE_4_VALIDASI/hitung_kelas_batasan.py dari shapes_pdp.ttl).
#  Aturan desain:
#   - Isolasi: entitas wakil hanya melanggar unit constraint kelasnya; seluruh kewajiban lain dipenuhi.
#   - Cakupan: gabungan entitas wakil dalam satu partisi melanggar seluruh unit constraint kelasnya.
#     Pada kelas tenggat, _Recorded (nilai kosong) dan _WithinLimit (> 72 jam) saling eksklusif,
#     sehingga partisinya memuat dua entitas wakil (Lewat dan Kosong).
#   - Partisi yang kelasnya menargetkan entitas peristiwa memakai Pengendali pendukung sendiri yang patuh.
#  Kelas pemicu dan entitas peristiwa ditulis eksplisit (peran lapisan ingesti arsitektur ACC).
#  Disclaimer: Data artifisial murni berbasis arketipe domain industri
#################################################################

# ===============================================================
# PARTISI ECP-02 (VALID): PERINGATAN DINI
# Domain: PSE E-Commerce Platform
# Setiap permintaan dan insiden ditindaklanjuti dalam 50-58 jam
# (> 48 jam tetapi <= 72 jam): sh:Warning tanpa sh:Violation.
# ===============================================================
pdp:PSE_Simulasi_ECM_Warning
    a pdp:DataController , pdp:PSE , pdp:ConsentBasedController ;
    rdfs:label "Arketipe PSE Sektor E-Commerce (Simulasi Peringatan Dini)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "consent" ;
    pdp:hasConsentEvidence true ;
    pdp:hasProcessingNotice true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Permintaan_Pembaruan_ECM
    a pdp:DataUpdateRequest ;
    rdfs:label "Permintaan pembaruan data pada PSE ECM"@id ;
    pdp:responsibleController pdp:PSE_Simulasi_ECM_Warning ;
    pdp:dataUpdateResponseHours 55 .              # WARNING: > 48 jam tapi <= 72 jam (Pasal 30 ayat (1))

pdp:Permintaan_Akses_ECM
    a pdp:DataAccessRequest ;
    rdfs:label "Permintaan akses data pada PSE ECM"@id ;
    pdp:responsibleController pdp:PSE_Simulasi_ECM_Warning ;
    pdp:dataAccessResponseHours 52 .              # WARNING: > 48 jam tapi <= 72 jam (Pasal 32 ayat (2))

pdp:Penarikan_Persetujuan_ECM
    a pdp:ConsentWithdrawalRequest ;
    rdfs:label "Permintaan penarikan kembali persetujuan pada PSE ECM"@id ;
    pdp:responsibleController pdp:PSE_Simulasi_ECM_Warning ;
    pdp:processingCessationHours 50 .             # WARNING: > 48 jam tapi <= 72 jam (Pasal 40 ayat (2))

pdp:Permintaan_Pembatasan_ECM
    a pdp:ProcessingRestrictionRequest ;
    rdfs:label "Permintaan penundaan dan pembatasan pemrosesan pada PSE ECM"@id ;
    pdp:responsibleController pdp:PSE_Simulasi_ECM_Warning ;
    pdp:processingRestrictionHours 53 .           # WARNING: > 48 jam tapi <= 72 jam (Pasal 41 ayat (1))

pdp:Insiden_ECM
    a pdp:BreachIncident ;
    rdfs:label "Kegagalan Pelindungan Data Pribadi pada PSE ECM"@id ;
    pdp:responsibleController pdp:PSE_Simulasi_ECM_Warning ;
    pdp:breachNotificationHours 58 ;              # WARNING: > 48 jam tapi <= 72 jam (Pasal 46 ayat (1))
    pdp:breachNotificationContainsRequiredElements true .

# ===============================================================
# PARTISI ECP-03 (K01): TENGGAT PEMBARUAN DATA (Pasal 30 ayat (1))
# Pengendali pendukung patuh + dua permintaan pembaruan: > 72 jam dan tidak tercatat.
# ===============================================================
pdp:Pengendali_ECP03
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-03 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Pembaruan_ECP03_Lewat
    a pdp:DataUpdateRequest ;
    rdfs:label "Permintaan pembaruan data ECP-03 (melewati 72 jam)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP03 ;
    pdp:dataUpdateResponseHours 96 .              # VIOLATION _WithinLimit + WARNING _EarlyWarning (Pasal 30 ayat (1))

pdp:Pembaruan_ECP03_Kosong
    a pdp:DataUpdateRequest ;
    rdfs:label "Permintaan pembaruan data ECP-03 (waktu tidak tercatat)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP03 .
                                                  # VIOLATION _Recorded: dataUpdateResponseHours tidak ada

# ===============================================================
# PARTISI ECP-04 (K02): TENGGAT AKSES DATA (Pasal 32 ayat (2))
# ===============================================================
pdp:Pengendali_ECP04
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-04 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Akses_ECP04_Lewat
    a pdp:DataAccessRequest ;
    rdfs:label "Permintaan akses data ECP-04 (melewati 72 jam)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP04 ;
    pdp:dataAccessResponseHours 120 .             # VIOLATION _WithinLimit + WARNING _EarlyWarning (Pasal 32 ayat (2))

pdp:Akses_ECP04_Kosong
    a pdp:DataAccessRequest ;
    rdfs:label "Permintaan akses data ECP-04 (waktu tidak tercatat)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP04 .
                                                  # VIOLATION _Recorded: dataAccessResponseHours tidak ada

# ===============================================================
# PARTISI ECP-05 (K03): TENGGAT PENGHENTIAN PEMROSESAN (Pasal 40 ayat (2))
# Pengendali pendukung berdasar persetujuan (aturan integritas (e)).
# ===============================================================
pdp:Pengendali_ECP05
    a pdp:DataController , pdp:PSE , pdp:ConsentBasedController ;
    rdfs:label "Pengendali pendukung ECP-05 (patuh, dasar persetujuan)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "consent" ;
    pdp:hasConsentEvidence true ;
    pdp:hasProcessingNotice true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Penarikan_ECP05_Lewat
    a pdp:ConsentWithdrawalRequest ;
    rdfs:label "Permintaan penarikan kembali persetujuan ECP-05 (melewati 72 jam)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP05 ;
    pdp:processingCessationHours 96 .             # VIOLATION _WithinLimit + WARNING _EarlyWarning (Pasal 40 ayat (2))

pdp:Penarikan_ECP05_Kosong
    a pdp:ConsentWithdrawalRequest ;
    rdfs:label "Permintaan penarikan kembali persetujuan ECP-05 (waktu tidak tercatat)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP05 .
                                                  # VIOLATION _Recorded: processingCessationHours tidak ada

# ===============================================================
# PARTISI ECP-06 (K04): TENGGAT PENUNDAAN DAN PEMBATASAN PEMROSESAN (Pasal 41 ayat (1))
# ===============================================================
pdp:Pengendali_ECP06
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-06 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
