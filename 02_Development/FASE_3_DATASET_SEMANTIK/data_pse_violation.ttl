pdp:Pembatasan_ECP06_Lewat
    a pdp:ProcessingRestrictionRequest ;
    rdfs:label "Permintaan penundaan dan pembatasan ECP-06 (melewati 72 jam)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP06 ;
    pdp:processingRestrictionHours 100 .          # VIOLATION _WithinLimit + WARNING _EarlyWarning (Pasal 41 ayat (1))

pdp:Pembatasan_ECP06_Kosong
    a pdp:ProcessingRestrictionRequest ;
    rdfs:label "Permintaan penundaan dan pembatasan ECP-06 (waktu tidak tercatat)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP06 .
                                                  # VIOLATION _Recorded: processingRestrictionHours tidak ada

# ===============================================================
# PARTISI ECP-07 (K05): TENGGAT PEMBERITAHUAN KEGAGALAN PDP (Pasal 46 ayat (1))
# Isi pemberitahuan (Pasal 46 ayat (2), kelas K15) dibuat lengkap agar partisi terisolasi.
# ===============================================================
pdp:Pengendali_ECP07
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-07 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Insiden_ECP07_Lewat
    a pdp:BreachIncident ;
    rdfs:label "Kegagalan Pelindungan Data Pribadi ECP-07 (pemberitahuan melewati 72 jam)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP07 ;
    pdp:breachNotificationHours 144 ;             # VIOLATION _WithinLimit + WARNING _EarlyWarning (Pasal 46 ayat (1))
    pdp:breachNotificationContainsRequiredElements true .

pdp:Insiden_ECP07_Kosong
    a pdp:BreachIncident ;
    rdfs:label "Kegagalan Pelindungan Data Pribadi ECP-07 (waktu pemberitahuan tidak tercatat)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP07 ;
    pdp:breachNotificationContainsRequiredElements true .
                                                  # VIOLATION _Recorded: breachNotificationHours tidak ada

# ===============================================================
# PARTISI ECP-08 (K06): KEAMANAN, KERAHASIAAN, PENGAWASAN, PEREKAMAN, DAN AKURASI
# (Pasal 29 ayat (2), 31, 35, 36, 37, 38, 39; bagi Prosesor jo. Pasal 52)
# Domain: PSE Infrastruktur & Basis Data Ritel beserta Prosesornya.
# Dua entitas wakil "tercatat false" karena kelas ini menargetkan pdp:DataController dan pdp:DataProcessor,
# ditambah satu wakil "tidak tercatat" (PSE_Simulasi_SEC_Kosong) untuk unit <X>_Recorded (pola catatan wajib, 2026-10-28).
# pdp:hasEncryption tidak lagi diperiksa (konsensus validator FO-16/FO-30); nilainya dibiarkan sebagai data deskriptif.
# ===============================================================
pdp:PSE_Simulasi_SEC_Violation
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Arketipe Pengendali dengan Pelanggaran Keamanan dan Akuntabilitas"@id ;
    pdp:hasEncryption false ;                     # deskriptif; tidak diperiksa sejak 2026-10-28
    pdp:hasAccessControl false ;                  # VIOLATION: Pasal 39 ayat (1)
    pdp:hasSecurityMeasures false ;               # VIOLATION: Pasal 35 huruf a dan Pasal 38
    pdp:hasConfidentialityMeasures false ;        # VIOLATION: Pasal 36
    pdp:hasSupervisionMechanism false ;           # VIOLATION: Pasal 37
    pdp:hasElectronicSecuritySystem false ;       # VIOLATION: Pasal 39 ayat (1) dan (2)
    pdp:hasProcessingAuditLog false ;             # VIOLATION: Pasal 31
    pdp:hasDataAccuracyVerification false ;       # VIOLATION: Pasal 29 ayat (2)
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Prosesor_Simulasi_SEC_Violation
    a pdp:DataProcessor , pdp:PSE ;
    rdfs:label "Arketipe Prosesor dengan Pelanggaran Keamanan dan Akuntabilitas (jo. Pasal 52)"@id ;
    pdp:processesOnlyUnderInstruction true ;      # Pasal 51 ayat (1) dipenuhi (kelas K17)
    pdp:hasEncryption false ;                     # deskriptif; tidak diperiksa sejak 2026-10-28
    pdp:hasAccessControl false ;                  # VIOLATION: Pasal 39 ayat (1) jo. Pasal 52
    pdp:hasSecurityMeasures false ;               # VIOLATION: Pasal 35 huruf a dan 38 jo. Pasal 52
    pdp:hasConfidentialityMeasures false ;        # VIOLATION: Pasal 36 jo. Pasal 52
    pdp:hasSupervisionMechanism false ;           # VIOLATION: Pasal 37 jo. Pasal 52
    pdp:hasElectronicSecuritySystem false ;       # VIOLATION: Pasal 39 ayat (1) dan (2) jo. Pasal 52
    pdp:hasProcessingAuditLog false ;             # VIOLATION: Pasal 31 jo. Pasal 52
    pdp:hasDataAccuracyVerification false ;       # VIOLATION: Pasal 29 ayat (2) jo. Pasal 52
    pdp:hasUnauthorizedProcessing false .

pdp:PSE_Simulasi_SEC_Kosong
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Arketipe Pengendali tanpa Catatan Keamanan dan Akuntabilitas"@id ;
    # Tujuh catatan grup Pasal 52 tidak ada -> VIOLATION <X>_Recorded (catatan tidak tersedia):
    # hasSecurityMeasures (Ps. 35 huruf a, 38), hasAccessControl (Ps. 39 ayat (1)), hasConfidentialityMeasures (Ps. 36),
    # hasSupervisionMechanism (Ps. 37), hasElectronicSecuritySystem (Ps. 39), hasProcessingAuditLog (Ps. 31),
    # hasDataAccuracyVerification (Ps. 29 ayat (2)).
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-09 (K07): PENILAIAN DAMPAK — PEMROSESAN DATA KESEHATAN (Pasal 34 ayat (1))
# Domain: PSE Layanan Kesehatan (Healthtech)
# Data kesehatan adalah Data Pribadi spesifik (Pasal 4 ayat (2) huruf a), sehingga pemrosesannya
# berpotensi risiko tinggi (Pasal 34 ayat (2) huruf b) dan Pengendali bertipe HighRiskProcessingController
# (aturan integritas (f1)). Satu-satunya pelanggaran: penilaian dampak tidak dilakukan.
# ===============================================================
pdp:Data_Kesehatan_HLT
    a pdp:SpecificPersonalData ;
    rdfs:label "Data rekam medis pasien pada PSE HLT"@id ;
    pdp:personalDataCategory "data dan informasi kesehatan" .   # Pasal 4 ayat (2) huruf a

pdp:PSE_Simulasi_HLT_Violation
    a pdp:DataController , pdp:PSE , pdp:ConsentBasedController , pdp:HighRiskProcessingController ;
    rdfs:label "Arketipe PSE Sektor Kesehatan (Simulasi Pemrosesan Data Kesehatan tanpa Penilaian Dampak)"@id ;
    pdp:processesPersonalData pdp:Data_Kesehatan_HLT ;
    pdp:hasDPIA false ;                           # VIOLATION: penilaian dampak tidak dilakukan (Pasal 34 ayat (1))
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "consent" ;
    pdp:hasConsentEvidence true ;
    pdp:hasProcessingNotice true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-10 (K08): DASAR PEMROSESAN (Pasal 20 ayat (1) dan (2))
# Dasar pemrosesan di luar enam dasar ayat (2). Bukan dasar persetujuan, sehingga bukan
# ConsentBasedController (aturan integritas (b)).
# ===============================================================
pdp:PSE_Simulasi_LGL_Violation
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Arketipe Pemrosesan tanpa Dasar Pemrosesan yang Sah"@id ;
    pdp:hasLegalBasis "unauthorized_commercial" ; # VIOLATION: di luar enam dasar Pasal 20 ayat (2)
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-11 (K09): KEWAJIBAN PEMROSESAN BERDASARKAN PERSETUJUAN (Pasal 21 ayat (1); Pasal 24)
# ===============================================================
pdp:PSE_Simulasi_CNS_Violation
    a pdp:DataController , pdp:PSE , pdp:ConsentBasedController ;
    rdfs:label "Arketipe Pemrosesan Berbasis Persetujuan tanpa Informasi dan Bukti Persetujuan"@id ;
    pdp:hasLegalBasis "consent" ;
    pdp:hasConsentEvidence false ;                # VIOLATION: bukti persetujuan tidak ada (Pasal 24)
    pdp:hasProcessingNotice false ;               # VIOLATION: informasi pemrosesan tidak disampaikan (Pasal 21 ayat (1))
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-12 (K10): PERSETUJUAN ORANG TUA/WALI ATAS DATA ANAK (Pasal 25 ayat (2))
# Data anak adalah Data Pribadi spesifik (Pasal 4 ayat (2) huruf e), sehingga Pengendali juga
# HighRiskProcessingController (aturan integritas (f1) dan (f2)) dan penilaian dampak dipenuhi.
# ===============================================================
pdp:Data_Anak_ANK
    a pdp:SpecificPersonalData ;
    rdfs:label "Data pribadi siswa pada PSE ANK"@id ;
    pdp:personalDataCategory "data anak" .       # Pasal 4 ayat (2) huruf e

pdp:PSE_Simulasi_ANK_Violation
    a pdp:DataController , pdp:PSE , pdp:ChildDataController , pdp:HighRiskProcessingController ;
    rdfs:label "Arketipe PSE Layanan Pendidikan Anak (Simulasi tanpa Persetujuan Orang Tua/Wali)"@id ;
    pdp:processesPersonalData pdp:Data_Anak_ANK ;
    pdp:hasParentalConsentForChild false ;        # VIOLATION: tanpa persetujuan orang tua/wali (Pasal 25 ayat (2))
    pdp:hasDPIA true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-13 (K11): PERSETUJUAN PENYANDANG DISABILITAS/WALI (Pasal 26 ayat (3))
# ===============================================================
pdp:PSE_Simulasi_DIS_Violation
    a pdp:DataController , pdp:PSE , pdp:DisabilityDataController ;
    rdfs:label "Arketipe Pemrosesan Data Penyandang Disabilitas tanpa Persetujuan"@id ;
    pdp:hasSpecialConsentForDisability false ;    # VIOLATION: tanpa persetujuan penyandang disabilitas/wali (Pasal 26 ayat (3))
    pdp:hasLegalBasis "contract" ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-14 (K12): PEMROSESAN TERBATAS, SPESIFIK, DAN SESUAI TUJUAN (Pasal 27 dan Pasal 28)
# ===============================================================
pdp:PSE_Simulasi_SIK_Violation
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Arketipe Pemrosesan di Luar Tujuan"@id ;
