    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-15 (K13): PENGENDALI BERSAMA (Pasal 18 ayat (2))
# ===============================================================
pdp:PSE_Simulasi_JNT_Violation
    a pdp:DataController , pdp:PSE , pdp:JointController ;
    rdfs:label "Arketipe Pengendali Bersama tanpa Perjanjian"@id ;
    pdp:hasJointControllerAgreement false ;       # VIOLATION: tanpa perjanjian peran, tujuan bersama, dan narahubung (Pasal 18 ayat (2))
    pdp:hasLegalBasis "contract" ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-16 (K14): PENGAKHIRAN PEMROSESAN (Pasal 42 ayat (1))
# Pengendali pendukung patuh + kondisi pengakhiran (huruf b: tujuan tercapai) tanpa pengakhiran pemrosesan.
# ===============================================================
pdp:Pengendali_ECP16
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-16 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Pengakhiran_ECP16
    a pdp:ProcessingTerminationGround ;
    rdfs:label "Tujuan pemrosesan tercapai pada Pengendali ECP-16"@id ;
    pdp:responsibleController pdp:Pengendali_ECP16 ;
    pdp:triggerGround "b" ;                       # Pasal 42 ayat (1) huruf b (informatif)
    pdp:processingTerminated false .              # VIOLATION: pemrosesan tidak diakhiri (Pasal 42 ayat (1))

# ===============================================================
# PARTISI ECP-17 (K15): ISI PEMBERITAHUAN KEGAGALAN PDP (Pasal 46 ayat (2))
# Tenggat Pasal 46 ayat (1) dipenuhi (24 jam) agar partisi terisolasi.
# ===============================================================
pdp:Pengendali_ECP17
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-17 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Insiden_ECP17
    a pdp:BreachIncident ;
    rdfs:label "Kegagalan Pelindungan Data Pribadi ECP-17 (isi pemberitahuan tidak lengkap)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP17 ;
    pdp:breachNotificationHours 24 ;
    pdp:breachNotificationContainsRequiredElements false . # VIOLATION: isi pemberitahuan tidak lengkap (Pasal 46 ayat (2))

# ===============================================================
# PARTISI ECP-18 (K16): TRANSFER KE LUAR WILAYAH HUKUM RI (Pasal 56 ayat (2) sampai (4))
# Domain: PSE Layanan Cloud Lintas Negara
# ===============================================================
pdp:Pengendali_ECP18
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-18 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Transfer_ECP18
    a pdp:CrossBorderTransfer ;
    rdfs:label "Transfer data ECP-18 ke luar wilayah hukum RI"@id ;
    pdp:responsibleController pdp:Pengendali_ECP18 ;
    pdp:dataTransferDestination "Yurisdiksi_Non_Adekuat" ;
    pdp:transferRecipientEquivalentProtection false ;   # Pasal 56 ayat (2) tidak terpenuhi
    pdp:transferHasAdequateBindingProtection false ;    # Pasal 56 ayat (3) tidak terpenuhi
    pdp:transferHasSubjectConsent false .               # VIOLATION: Pasal 56 ayat (4) juga tidak terpenuhi

# ===============================================================
# PARTISI ECP-19 (K17): PROSESOR DI LUAR PERINTAH PENGENDALI (Pasal 51 ayat (1))
# Domain: Vendor Pihak Ketiga / Pengolah Data Subkontraktor
# Kewajiban yang berlaku melalui Pasal 52 (kelas K06) dipenuhi agar partisi terisolasi.
# ===============================================================
pdp:Prosesor_Simulasi_CLD_Violation
    a pdp:DataProcessor , pdp:PSE ;
    rdfs:label "Arketipe Pelanggaran Prosesor Cloud (Simulasi Pemrosesan di Luar Perintah)"@id ;
    pdp:processesOnlyUnderInstruction false ;     # VIOLATION: memproses di luar perintah Pengendali (Pasal 51 ayat (1))
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-20 (K18): PENGUNGKAPAN/PENGGUNAAN DATA TANPA HAK (Pasal 65 ayat (2) dan (3))
# Entitas bertipe pdp:PSE saja, sehingga hanya menjadi target shape larangan.
# ===============================================================
pdp:PSE_Simulasi_ILLEGAL_Violation
    a pdp:PSE ;
    rdfs:label "Arketipe Pelanggaran Larangan (Simulasi Pengungkapan/Penggunaan Data Tanpa Hak)"@id ;
    pdp:hasUnauthorizedProcessing true .         # VIOLATION: indikator pengungkapan/penggunaan data tanpa hak (Pasal 65 ayat (2)-(3))

# ===============================================================
# PARTISI ECP-21 (K19): PEMBERITAHUAN PENGALIHAN DATA PADA AKSI KORPORASI (Pasal 48 ayat (1) dan (2))
# Pengendali pendukung patuh (badan hukum) + aksi korporasi selesai tanpa pemberitahuan sebelum dan sesudah.
# ===============================================================
pdp:Pengendali_ECP21
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-21 (patuh, badan hukum)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:AksiKorporasi_ECP21
    a pdp:CorporateAction ;
    rdfs:label "Pengambilalihan badan hukum Pengendali ECP-21 (aksi selesai)"@id ;
    pdp:responsibleController pdp:Pengendali_ECP21 ;
    pdp:corporateActionType "pengambilalihan" ;
    pdp:transferNoticeBeforeAction false ;        # VIOLATION: tanpa pemberitahuan sebelum (Pasal 48 ayat (1)-(2))
    pdp:transferNoticeAfterAction false .         # VIOLATION: tanpa pemberitahuan sesudah (Pasal 48 ayat (1)-(2))

# ===============================================================
# PARTISI ECP-22 (K20): PENUNJUKAN PEJABAT/PETUGAS PDP (Pasal 53 ayat (1))
# Dua entitas wakil karena kewajiban berlaku bagi Pengendali dan Prosesor. Masing-masing hanya memenuhi
# SATU huruf pemicu, sehingga partisi ini juga menunjukkan bahwa huruf a, b, c bersifat alternatif
# (Putusan MK Nomor 151/PUU-XXII/2024).
# ===============================================================
pdp:PSE_Simulasi_DPO_Violation
    a pdp:DataController , pdp:PSE , pdp:LargeScaleMonitoringActor , pdp:HighRiskProcessingController ;
    rdfs:label "Arketipe Platform Analitik Perilaku Pengguna tanpa Pejabat/Petugas PDP (huruf b)"@id ;
    pdp:hasDataProtectionOfficer false ;          # VIOLATION: pejabat/petugas PDP tidak ditunjuk (Pasal 53 ayat (1) huruf b)
    pdp:hasDPIA true ;                            # huruf b juga berarti risiko tinggi (Pasal 34 ayat (2) huruf c-d; aturan (f3))
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Prosesor_Simulasi_DPO_Violation
    a pdp:DataProcessor , pdp:PSE , pdp:PublicServiceProcessingActor ;
    rdfs:label "Arketipe Prosesor Layanan Publik tanpa Pejabat/Petugas PDP (huruf a)"@id ;
    pdp:hasDataProtectionOfficer false ;          # VIOLATION: pejabat/petugas PDP tidak ditunjuk (Pasal 53 ayat (1) huruf a)
    pdp:processesOnlyUnderInstruction true ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasUnauthorizedProcessing false .

# ===============================================================
# PARTISI ECP-23 (K21): PORTABILITAS ATAS PERMINTAAN SUBJEK (Pasal 13 ayat (1))
# Pemicu permintaan adalah interpretasi peneliti (teks tidak menyebut "permintaan").
# ===============================================================
pdp:Pengendali_ECP23
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-23 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Permintaan_Portabilitas_ECP23
    a pdp:DataPortabilityRequest ;
    rdfs:label "Permintaan Subjek atas Data Pribadi dalam format terstruktur pada Pengendali ECP-23"@id ;
    pdp:responsibleController pdp:Pengendali_ECP23 ;
    pdp:portableFormatProvided false .            # VIOLATION: tidak disediakan dalam format terstruktur (Pasal 13 ayat (1))

# ===============================================================
# PARTISI ECP-24 (K22): PENGHAPUSAN (Pasal 43 ayat (1))
# Penghapusan tidak dilakukan sehingga tidak ada yang perlu diberitahukan (Pasal 45 tidak terpicu).
# ===============================================================
pdp:Pengendali_ECP24
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-24 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Penghapusan_ECP24
    a pdp:DeletionGround ;
    rdfs:label "Permintaan penghapusan Subjek pada Pengendali ECP-24"@id ;
    pdp:responsibleController pdp:Pengendali_ECP24 ;
    pdp:triggerGround "c" ;                       # Pasal 43 ayat (1) huruf c (informatif)
    pdp:erasureCarriedOut false .                 # VIOLATION: data tidak dihapus (Pasal 43 ayat (1))

# ===============================================================
# PARTISI ECP-25 (K23): PEMUSNAHAN (Pasal 44 ayat (1))
# ===============================================================
pdp:Pengendali_ECP25
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-25 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Pemusnahan_ECP25
    a pdp:DestructionGround ;
    rdfs:label "Data diperoleh secara melawan hukum pada Pengendali ECP-25"@id ;
    pdp:responsibleController pdp:Pengendali_ECP25 ;
    pdp:triggerGround "d" ;                       # Pasal 44 ayat (1) huruf d (informatif)
    pdp:erasureCarriedOut false .                 # VIOLATION: data tidak dimusnahkan (Pasal 44 ayat (1))

# ===============================================================
# PARTISI ECP-26 (K24): PEMBERITAHUAN PENGHAPUSAN DAN/ATAU PEMUSNAHAN (Pasal 45)
# Penghapusan dilakukan (Pasal 43 ayat (1) dipenuhi), tetapi Subjek tidak diberi tahu.
# ===============================================================
pdp:Pengendali_ECP26
    a pdp:DataController , pdp:PSE ;
    rdfs:label "Pengendali pendukung ECP-26 (patuh)"@id ;
    pdp:hasEncryption true ;
    pdp:hasAccessControl true ;
    pdp:hasSecurityMeasures true ;
    pdp:hasConfidentialityMeasures true ;
    pdp:hasSupervisionMechanism true ;
    pdp:hasElectronicSecuritySystem true ;
    pdp:hasProcessingAuditLog true ;
    pdp:hasLegalBasis "contract" ;
    pdp:hasDataMinimization true ;
    pdp:hasDataAccuracyVerification true ;
    pdp:hasRetentionPeriod 365 ;
    pdp:hasUnauthorizedProcessing false .

pdp:Penghapusan_ECP26
    a pdp:DeletionGround ;
    rdfs:label "Penarikan kembali persetujuan pada Pengendali ECP-26 diikuti penghapusan"@id ;
    pdp:responsibleController pdp:Pengendali_ECP26 ;
    pdp:triggerGround "b" ;                       # Pasal 43 ayat (1) huruf b (informatif)
    pdp:erasureCarriedOut true ;                  # Pasal 43 ayat (1) dipenuhi
    pdp:subjectNotifiedOfErasure false .          # VIOLATION: Subjek tidak diberi tahu (Pasal 45)
